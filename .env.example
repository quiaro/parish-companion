# Defaults to "production" if unset. 
# docker-compose.dev.yml sets this to `development`
ENVIRONMENT=production

DEFAULT_LANGUAGE=es

# /schedules command — Google Sheets data adapter
SCHEDULES_GOOGLE_CREDENTIALS_HOST_PATH=./secrets/google-service-account.json
SCHEDULES_GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
SCHEDULES_REGULAR_TAB=Regular Schedule
SCHEDULES_SPECIAL_TAB=Special Schedules
SCHEDULES_CACHE_TTL_SECONDS=3600

# /information command — Google Sheets data adapter
INFORMATION_GOOGLE_CREDENTIALS_HOST_PATH=./secrets/google-service-account.json
INFORMATION_GOOGLE_SPREADSHEET_ID=your-information-spreadsheet-id-here
INFORMATION_TOPICS_TAB=Information
INFORMATION_CACHE_TTL_SECONDS=3600

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_EMBEDDING_MODEL=openrouter-embedding-model-name-here
OPENROUTER_CHAT_MODEL=openrouter-chat-model-name-here

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here
TELEGRAM_WEBHOOK_URL=https://your-public-host/webhook

# Redis
REDIS_URL=redis://redis:6379/0

# How long (in seconds) session data lives in Redis: the stored language preference and
# any in-progress multi-step flow state. Default: 24 hours.
SESSION_TTL_SECONDS=86400

# Postgres
POSTGRES_USER=parish_companion
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=parish_companion
DATABASE_URL=postgresql+psycopg://parish_companion:your-postgres-password-here@postgres:5432/parish_companion

# IANA timezone name for this parish (e.g. America/Costa_Rica, America/Chicago)
# Used to record stats by local time of day.
LOCAL_TIMEZONE=America/Costa_Rica

# Backups — daily pg_dump uploaded to S3 (rolling 7-day, one file per weekday)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_DEFAULT_REGION=us-east-1
BACKUP_S3_BUCKET=your-backup-bucket-name-here

# Contact form — /contact command
CONTACT_EMAIL_RECIPIENTS=["pastor@your-parish.org","secretary@your-parish.org"]
CONTACT_PHONE=+1 (555) 000-0000
CONTACT_REQUEST_TYPES=["Speak with a priest","Spiritual director appointment","Pastoral minister","General question"]
CONTACT_REQUEST_TYPES_ES=["Hablar con un sacerdote","Cita con un director espiritual","Ministro pastoral","Pregunta general"]

# SMTP - used to deliver form submissions and staff notifications (required in production)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USERNAME=bot@your-parish.org
SMTP_PASSWORD=your-smtp-password-here
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=bot@your-parish.org

# /comfort command
COMFORT_NOTIFICATION_DEDUP_WINDOW_HOURS=24
COMFORT_FREQUENCY_WINDOW_HOURS=24
COMFORT_ESCALATION_PASSAGE_THRESHOLD=10
COMFORT_SIMILARITY_THRESHOLD=0.2

# Qdrant — verse bank
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=bible_verses

# Langfuse (optional) — timing/metadata-only tracing of the /comfort retrieval
# pipeline (no message content or parishioner identifier). Leave both keys
# unset to disable tracing entirely.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000
